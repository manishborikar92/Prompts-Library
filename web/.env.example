# =============================================================================
# Supabase Configuration
# =============================================================================

# Supabase Project URL (from Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Publishable Key (new format) or Anon Key (legacy)
# Get from Dashboard > Settings > API > API Keys
# New format: sb_publishable_xxx
# Legacy format: eyJ... (anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Supabase Service Role Key (Server only - NEVER expose to client!)
# Get from Dashboard > Settings > API > Legacy API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# =============================================================================
# Database Configuration (Drizzle ORM)
# =============================================================================

# Pooled connection for general use (with pgbouncer)
# Get from Dashboard > Settings > Database > Connection String > Transaction Pooler
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations (without pgbouncer)
# Get from Dashboard > Settings > Database > Connection String > Session Pooler
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# =============================================================================
# OAuth Providers (Configured in Supabase Dashboard)
# =============================================================================

# GitHub OAuth
# 1. Create app at: https://github.com/settings/developers
# 2. Set callback URL: https://[YOUR-PROJECT-REF].supabase.co/auth/v1/callback
# 3. Enable in Supabase: Dashboard > Authentication > Providers > GitHub
# Note: Client ID and Secret are stored in Supabase, not your app
# These are optional here, only for reference
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# =============================================================================
# Application Configuration
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PromptBase"
NODE_ENV="development"

# =============================================================================
# Optional: Google AI (Gemini) for AI Features
# =============================================================================

# Google AI API Key (from Google AI Studio: https://aistudio.google.com)
# GOOGLE_AI_API_KEY="AIza..."
